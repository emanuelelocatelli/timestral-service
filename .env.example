PORT=8003
HOST=0.0.0.0

# mistralai/Timestral-5M | Timestral-28M | Timestral-123M | Timestral-209M
MODEL_NAME=mistralai/Timestral-209M
DEVICE=cpu
TORCH_NUM_THREADS=4

DEFAULT_PREDICTION_HORIZON=8
DEFAULT_INTERVAL_SECONDS=3600
MAX_BATCH_SERIES=64

SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO

# Empty means /predict is open. Production sets a bearer token.
API_TOKEN=

HF_HOME=/app/data/huggingface

PORT=8003
HOST=0.0.0.0

# mistralai/Timestral-5M | Timestral-28M | Timestral-123M | Timestral-209M
MODEL_NAME=mistralai/Timestral-209M
DEVICE=cpu
TORCH_NUM_THREADS=4

DEFAULT_PREDICTION_HORIZON=8
DEFAULT_INTERVAL_SECONDS=3600
MAX_BATCH_SERIES=64

SERVICE_VERSION=1.1.0
LOG_LEVEL=INFO

# Imported into the token table on startup. The admin page can issue more.
API_TOKEN=

DATABASE_PATH=data/timestral.db
ADMIN_EMAIL=emanuele.locatelli@hotmail.it
ADMIN_PASSWORD=change-me
SECRET_KEY=
# Traefik on the Coolify network. Only this peer may set X-Forwarded-For.
TRUSTED_PROXIES=172.18.0.2/32

HF_HOME=/app/data/huggingface
